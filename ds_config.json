{
  "gradient_accumulation_steps": 16,
  "train_micro_batch_size_per_gpu": 16,
  "gradient_clipping": 1.0,
  "optimizer": {
    "type": "AdamW",
    "params": {
      "lr": 0.0001,
      "betas": [0.9, 0.999],
      "eps": 1e-8,
      "weight_decay": 0.0001
    }
  },
  "bf16": {
    "enabled": true
  },
  "zero_optimization": {
    "stage": 2,
    "overlap_comm": true,
    "allgather_bucket_size": 5e8,
    "reduce_bucket_size": 5e8
  },
  "checkpoint": {
    "save_dir": "./checkpoints",
    "load_dir": "./checkpoints",
    "checkpoint_steps": 10
  },
  "flops_profiler": {
    "enabled": true,
    "profile_step": 100,
    "module_depth": -1,
    "top_modules": 3,
    "detailed": true,
    "output_file": "profiles/flops_profile.txt"
  },
  "steps_per_print": 10,
  "wall_clock_breakdown": false
}

{
  "bf16": { "enabled": true },

  "zero_optimization": {
    "stage": 2,               
    "overlap_comm": true,
    "allgather_bucket_size": 5e8,
    "reduce_bucket_size": 5e8,
    "contiguous_gradients": true
  },

  "train_micro_batch_size_per_gpu": 32,
  "gradient_accumulation_steps": 4,

  "wall_clock_breakdown": true,

  "flops_profiler": {
    "enabled": true,
    "profile_step": [1, 200, 2000, 10000],
    "module_depth": -1,
    "top_modules": 3,
    "detailed": true,
    "output_file": "profiles/flops_profile_rank${RANK}.txt"
  }
}
